<%- layout("./layouts/boilerPlate") %>

<style>
  :root {
    --brand-primary: #f17649;
    --brand-dark: #d9531e;
    --brand-gradient: linear-gradient(135deg, #f17649 0%, #d9531e 100%);
    --dark-surface: #0b0f17;
    --dark-surface-elevated: #151c28;
    --bg-light: #f8fafc;
    --text-dark: #0f172a;
    --text-muted: #64748b;
    --border-subtle: #e2e8f0;
    --radius-2xl: 24px;
    --radius-xl: 16px;
    --shadow-soft: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
    --shadow-elevated: 0 20px 40px -10px rgba(15, 23, 42, 0.12);
  }

  /* Header Banner */
  .profile-banner {
    background: linear-gradient( #0b0f17 0%, #151c28 100%);
    height: 180px;
    border-radius: var(--radius-2xl);
    position: relative;
    box-shadow: var(--shadow-elevated);
  }

  .profile-avatar-wrapper {
    position: relative;
    margin-top: -65px;
  }

  .profile-avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #ffffff;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    background-color: #ffffff;
  }

  /* Info Cards */
  .profile-card {
    background: #ffffff;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-soft);
    padding: 2rem;
  }

  .info-box {
    background: #f8fafc;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition: all 0.3s ease;
  }

  .info-box:hover {
    background: #ffffff;
    border-color: var(--brand-primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .info-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(241, 118, 73, 0.1);
    color: var(--brand-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .btn-brand-primary {
    background: var(--brand-gradient);
    color: #ffffff !important;
    border: none;
    font-weight: 600;
    padding: 0.65rem 1.5rem;
    border-radius: 50px;
    box-shadow: 0 8px 20px rgba(241, 118, 73, 0.3);
    transition: all 0.3s ease;
  }

  .btn-brand-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(241, 118, 73, 0.45);
  }
</style>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">

      <!-- Profile Header Banner -->
      <div class="profile-banner d-flex align-items-end p-4 mb-4">
        <span class="badge bg-warning text-dark rounded-pill fw-bold px-3 py-2 ms-auto" style="font-size: 0.8rem;">
          <i class="fa-solid fa-circle-check text-success me-1"></i> Verified User
        </span>
      </div>

      <!-- Main Profile Card -->
      <div class="profile-card position-relative mb-4">
        <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end justify-content-between gap-3 pb-4 border-bottom mb-4">
          
          <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end gap-3 text-center text-md-start">
            <div class="profile-avatar-wrapper">
              <!-- Dynamically creates avatar initials using user's first & last name -->
              <img 
                src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.first_name + ' ' + user.last_name) %>&background=f17649&color=fff&size=256&font-size=0.4" 
                alt="<%= user.first_name %> <%= user.last_name %>" 
                class="profile-avatar"
              >
            </div>
            <div>
              <h2 class="fw-bold text-dark mb-1"><%= user.first_name %> <%= user.last_name %></h2>
              <p class="text-muted mb-0">@<%= user.username %></p>
            </div>
          </div>

          <!-- Actions -->
          <div class="d-flex gap-2">
            <% if(currUser && currUser._id.equals(user._id)){ %>
              <a href="/users/edit" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" style="display: flex; justify-content: center;align-items: center;">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
              </a>
            <% } %>
            <form action="/users/<%= user._id %>?_method=DELETE" method="POST" class="d-inline">
              <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">
                <i class="fa-solid fa-trash me-1"></i> Delete User
              </button>
            </form>
          </div>

        </div>

        <!-- Details Grid -->
        <h5 class="fw-bold text-dark mb-3">Account Details</h5>
        <div class="row g-3">
          
          <div class="col-12 col-md-6">
            <div class="info-box">
              <div class="info-icon">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <span class="text-muted d-block small fw-semibold text-uppercase">Full Name</span>
                <span class="fw-bold text-dark fs-6"><%= user.first_name %> <%= user.last_name %></span>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <div class="info-box">
              <div class="info-icon">
                <i class="fa-solid fa-at"></i>
              </div>
              <div>
                <span class="text-muted d-block small fw-semibold text-uppercase">Username</span>
                <span class="fw-bold text-dark fs-6">@<%= user.username %></span>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <div class="info-box">
              <div class="info-icon">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div class="text-truncate">
                <span class="text-muted d-block small fw-semibold text-uppercase">Email Address</span>
                <span class="fw-bold text-dark fs-6 text-truncate d-block"><%= user.email_id %></span>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <div class="info-box">
              <div class="info-icon">
                <i class="fa-solid fa-phone"></i>
              </div>
              <div>
                <span class="text-muted d-block small fw-semibold text-uppercase">Mobile Number</span>
                <span class="fw-bold text-dark fs-6">+91 <%= user.number %></span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>