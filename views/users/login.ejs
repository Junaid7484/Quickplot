<%= layout("./layouts/boilerplate") %>

<style>
  :root {
    --studio-bg: #0f172a;
    --studio-card: rgba(255, 255, 255, 0.96);
    --studio-text: #0f172a;
    --studio-muted: #64748b;
    --studio-border: #e2e8f0;
    --studio-accent: #f17649;
    --studio-hover: #d9531e;
    --studio-gradient: linear-gradient(135deg, #f06bad 0%, #f17649 100%);
    --studio-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.25);
  }

  /* Ambient Glowing Background Canvas */
  body {
    background-color: var(--studio-bg);
    background-image: 
      radial-gradient(circle at 15% 15%, rgba(240, 107, 173, 0.18) 0%, transparent 45%),
      radial-gradient(circle at 85% 85%, rgba(241, 118, 73, 0.18) 0%, transparent 45%);
    background-attachment: fixed;
    color: var(--studio-text);
    min-height: 100vh;
  }

  /* Wide Glassmorphic Card */
  .studio-card-wide {
    background: var(--studio-card);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 28px !important;
    box-shadow: var(--studio-shadow);
    overflow: hidden;
    position: relative;
  }

  /* Top Gradient Accent Bar */
  .card-top-bar {
    height: 6px;
    background: linear-gradient(90deg, #f06bad, #f17649, #ff8c42);
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Left Hero Banner Panel */
  .studio-banner {
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .banner-badge {
    background: rgba(241, 118, 73, 0.15);
    color: var(--studio-accent);
    font-size: 0.725rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.45rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(241, 118, 73, 0.25);
    display: inline-block;
  }

  /* Feature Highlight Cards */
  .feature-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1rem 1.25rem;
    transition: background 0.2s ease;
  }

  .feature-pill:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Form Labels & Interactive Input Icon Wrapper */
  .studio-label {
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #475569;
    margin-bottom: 0.45rem;
  }

  .input-icon-group {
    position: relative;
  }

  .input-icon-group .icon-left {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    font-size: 1rem;
    z-index: 5;
    transition: color 0.2s ease;
  }

  .input-icon-group:focus-within .icon-left {
    color: var(--studio-accent);
  }

  /* Form Controls with Clean Focus (Zero Outer Shadow) */
  .studio-input {
    height: 3.5rem;
    border: 1.5px solid var(--studio-border);
    border-radius: 14px !important;
    padding-left: 3rem !important;
    padding-right: 2.75rem !important;
    font-size: 0.95rem;
    font-weight: 500;
    background-color: #f8fafc;
    color: var(--studio-text);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .studio-input:focus {
    background-color: #ffffff !important;
    border-color: var(--studio-accent) !important;
    box-shadow: none !important;
    outline: none !important;
  }

  /* Password Toggle Button */
  .toggle-password-btn {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: 1rem;
    padding: 6px 10px;
    z-index: 5;
    transition: color 0.2s ease;
  }

  .toggle-password-btn:hover {
    color: var(--studio-accent);
  }

  /* Gradient Heading */
  .gradient-title {
    font-weight: 800;
    font-size: clamp(1.85rem, 3.5vw, 2.4rem);
    background: var(--studio-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.025em;
  }

  /* Submit Action Button */
  .btn-studio {
    height: 3.6rem;
    background: linear-gradient(135deg, #f17649 0%, #d9531e 100%) !important;
    color: #ffffff !important;
    font-weight: 700;
    border: none !important;
    border-radius: 16px !important;
    font-size: 1rem;
    letter-spacing: 0.02em;
    box-shadow: 0 10px 22px -4px rgba(241, 118, 73, 0.4);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .btn-studio:hover {
    background: linear-gradient(135deg, #f06bad 0%, #f17649 100%) !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -4px rgba(240, 107, 173, 0.45) !important;
  }

  .btn-studio:active {
    transform: translateY(-1px);
    box-shadow: 0 6px 15px -3px rgba(241, 118, 73, 0.4) !important;
  }

  /* Navigation Links */
  .studio-link {
    color: var(--studio-accent);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .studio-link:hover {
    color: var(--studio-hover);
    text-decoration: underline;
  }
</style>

<div class="container-fluid px-3 px-md-5 my-4 my-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      
      <div class="studio-card-wide">
        <!-- Top Visual Bar -->
        <div class="card-top-bar"></div>

        <div class="row g-0">
          
          <!-- Left Column: Modern Banner & Features -->
          <div class="col-12 col-lg-5 studio-banner">
            <div>
              <span class="banner-badge mb-3">QUICKPLOT CONSOLE</span>
              <h2 class="fw-bold mb-2 text-white">Sign in to your dashboard</h2>
              <p class="small mb-4" style="color: #cbd5e1; line-height: 1.6;">
                Access your real estate listings, manage active buyer inquiries, and update property pricing seamlessly.
              </p>

              <div class="d-flex flex-column gap-3">
                <div class="feature-pill d-flex align-items-center gap-3">
                  <i class="fa-solid fa-chart-line text-warning fs-4"></i>
                  <div>
                    <h6 class="text-white fw-bold mb-0 small">Live View Analytics</h6>
                    <small style="color: #cbd5e1; font-size: 0.78rem;">Track daily views on all posted plots.</small>
                  </div>
                </div>

                <div class="feature-pill d-flex align-items-center gap-3">
                  <i class="fa-solid fa-phone text-info fs-4"></i>
                  <div>
                    <h6 class="text-white fw-bold mb-0 small">Direct Buyer Leads</h6>
                    <small style="color: #cbd5e1; font-size: 0.78rem;">Get immediate calls and WhatsApp inquiries.</small>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-4 border-top border-secondary mt-5">
              <small class="d-block" style="color: #94a3b8;">Need help with your account?</small>
              <strong class="text-white">support@quickplot.com</strong>
            </div>
          </div>

          <!-- Right Column: Login Form Editor -->
          <div class="col-12 col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
            
            <div class="mb-4">
              <h1 class="gradient-title mb-1">Welcome Back!</h1>
              <p class="text-muted small mb-0 fw-medium">
                Don't have an account yet? 
                <a href="/users/signup" class="studio-link">Create one now</a>
              </p>
            </div>

            <form action="/users/login" method="post" class="needs-validation" novalidate>
              
              <!-- Username Input -->
              <div class="mb-3.5 mb-3">
                <label for="username" class="studio-label d-block">Username *</label>
                <div class="input-icon-group">
                  <i class="fa-solid fa-at icon-left"></i>
                  <input 
                    type="text" 
                    class="form-control studio-input" 
                    id="username" 
                    name="username" 
                    placeholder="e.g. john_doe" 
                    required 
                  />
                </div>
              </div>

              <!-- Password Input with Toggle -->
              <div class="mb-4">
                <label for="password" class="studio-label d-block">Password *</label>
                <div class="input-icon-group">
                  <i class="fa-solid fa-lock icon-left"></i>
                  <input 
                    type="password" 
                    class="form-control studio-input" 
                    id="password" 
                    name="password" 
                    placeholder="•••••••••" 
                    required 
                  />
                </div>
              </div>

              <!-- Submit Action -->
              <button type="submit" class="btn btn-studio w-100 d-flex align-items-center justify-content-center gap-2">
                <i class="fa-solid fa-right-to-bracket fs-5"></i>
                <span>Sign In to Account</span>
              </button>

            </form>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>
