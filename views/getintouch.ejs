<% layout("/layouts/boilerplate") %> <%= success %>

<div class="container my-4 my-md-5 contact-wrapper" style="max-width: 1080px">
  <!-- Header -->
  <div class="text-center mb-5">
    <h1 class="section-title-gradient mb-2">Contact Us</h1>
    <p
      class="text-slate-400 mx-auto mb-0 fw-medium"
      style="
        color: #adbfd8;
        max-width: 580px;
        font-size: 1.05rem;
        line-height: 1.6;
      "
    >
      We'd love to hear from you! Whether you have a question about our
      services, need assistance, or want to partner with us.
    </p>
  </div>

  <!-- Support Guarantee Badge -->
  <div
    class="alert bg-dark text-light border border-secondary rounded-4 p-3 mb-4 d-flex align-items-center gap-3 justify-content-center flex-wrap shadow-sm"
    style="border-color: rgba(255, 255, 255, 0.1) !important"
  >
    <div
      class="d-flex align-items-center gap-2 text-warning fw-bold small text-uppercase"
    >
      <i class="fa-solid fa-bolt fs-5"></i>
      <span>Fast Support Guarantee</span>
    </div>
    <span class="text-slate-400 small">|</span>
    <span class="small text-slate-300"
      >We typically respond to inquiries within
      <strong>2 to 4 hours</strong> during business hours.</span
    >
  </div>

  <!-- Main Grid -->
  <div class="row g-4 justify-content-center mb-5">
    <!-- Left Column: Contact Info Card -->
    <div class="col-12 col-md-5">
      <div
        class="glass-card p-4 p-lg-4 h-100 d-flex flex-column justify-content-between"
      >
        <div>
          <h2 class="card-heading mb-4">Get In Touch</h2>

          <!-- Location -->
          <div class="d-flex align-items-center mb-3 info-item">
            <div class="contact-icon-badge me-3">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <div>
              <h6 class="mb-0.5 fw-bold text-light" style="font-size: 0.95rem">
                Our Location
              </h6>
              <p
                class="text-slate-400 mb-0 small fw-medium"
                style="color: #94a3b8; line-height: 1.4"
              >
                Dwarikapuri Road No.1,<br />
                Danapur Patna, Bihar
              </p>
            </div>
          </div>

          <!-- Phone -->
          <div class="d-flex align-items-center mb-3 info-item">
            <div class="contact-icon-badge me-3">
              <i class="fa-solid fa-phone"></i>
            </div>
            <div>
              <h6 class="mb-0.5 fw-bold text-light" style="font-size: 0.95rem">
                Phone
              </h6>
              <p
                class="text-slate-400 mb-0 small fw-semibold"
                style="color: #94a3b8"
              >
                +91 8340252282
              </p>
            </div>
          </div>

          <!-- Email -->
          <div class="d-flex align-items-center mb-3 info-item">
            <div class="contact-icon-badge me-3">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <div>
              <h6 class="mb-0.5 fw-bold text-light" style="font-size: 0.95rem">
                Email
              </h6>
              <p
                class="text-slate-400 mb-0 small fw-semibold"
                style="color: #94a3b8"
              >
                contact@quickplot.com
              </p>
            </div>
          </div>

          <!-- Business Hours -->
          <div class="d-flex align-items-center mb-3 info-item">
            <div class="contact-icon-badge me-3">
              <i class="fa-solid fa-clock"></i>
            </div>
            <div>
              <h6 class="mb-0.5 fw-bold text-light" style="font-size: 0.95rem">
                Business Hours
              </h6>
              <p
                class="text-slate-400 mb-0 small fw-medium"
                style="color: #94a3b8; line-height: 1.4"
              >
                Mon - Fri: 9am - 6pm <br />
                Sat: 10am - 1pm | Sun: Closed
              </p>
            </div>
          </div>

          <!-- Map Direct Access Widget -->
          <div
            class="map-preview-banner mt-3 d-flex align-items-center justify-content-between"
          >
            <div class="d-flex align-items-center gap-2.5">
              <i class="fa-solid fa-map-location-dot text-warning fs-4"></i>
              <div>
                <span class="text-light fw-bold d-block small"
                  >Patna Office Directions</span
                >
                <small class="text-muted">Navigate with Google Maps</small>
              </div>
            </div>
            <a
              href="https://www.google.com/maps/place/1,+Dwarikapuri+Main+Rd/@25.5870813,85.0318221,18z"
              target="_blank"
              class="btn btn-outline-light btn-sm rounded-pill fw-bold"
            >
              Open <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
            </a>
          </div>
        </div>

        <!-- Social Links -->
        <div
          class="mt-4 border-top border-secondary pt-3"
          style="border-color: rgba(255, 255, 255, 0.1) !important"
        >
          <h6
            class="fw-bold mb-3 text-light small uppercase"
            style="letter-spacing: 0.06em"
          >
            Follow Us
          </h6>
          <div class="d-flex gap-2.5 flex-wrap">
            <a href="#" class="btn social-btn" aria-label="Facebook">
              <i class="fa-brands fa-facebook-f"></i>
            </a>
            <a href="#" class="btn social-btn" aria-label="Twitter">
              <i class="fa-brands fa-x-twitter"></i>
            </a>
            <a
              href="https://www.instagram.com/science__world8"
              target="_blank"
              class="btn social-btn"
              aria-label="Instagram"
            >
              <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="#" class="btn social-btn" aria-label="YouTube">
              <i class="fa-brands fa-youtube"></i>
            </a>
            <a
              href="https://www.linkedin.com/in/junaid-alam7484"
              target="_blank"
              class="btn social-btn"
              aria-label="LinkedIn"
            >
              <i class="fa-brands fa-linkedin-in"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Contact Form -->
    <div class="col-12 col-md-7">
      <div class="glass-card p-4 p-lg-4 h-100">
        <h2 class="card-heading mb-4">Send Us a Message</h2>

        <form
          class="contact-form needs-validation"
          novalidate
          action="/quickplots/contact"
          method="post"
        >
          <div class="row g-3">
            <!-- Name -->
            <div class="col-12 col-sm-6">
              <label for="your-name" class="form-label-custom mb-1.5"
                >Your Name *</label
              >
              <div class="input-icon-group">
                <i class="fa-solid fa-user"></i>
                <input
                  type="text"
                  name="name"
                  id="your-name"
                  class="form-control form-control-custom"
                  placeholder="John Doe"
                  required
                />
              </div>
            </div>

            <!-- Phone -->
            <div class="col-12 col-sm-6">
              <label for="your-phone" class="form-label-custom mb-1.5"
                >Phone Number</label
              >
              <div class="input-icon-group">
                <i class="fa-solid fa-phone"></i>
                <input
                  type="tel"
                  name="phone"
                  id="your-phone"
                  class="form-control form-control-custom"
                  placeholder="+91 9876543210"
                />
              </div>
            </div>

            <!-- Email -->
            <div class="col-12">
              <label for="your-email" class="form-label-custom mb-1.5"
                >Your Email *</label
              >
              <div class="input-icon-group">
                <i class="fa-solid fa-envelope"></i>
                <input
                  type="email"
                  name="email"
                  id="your-email"
                  class="form-control form-control-custom"
                  placeholder="name@example.com"
                  required
                />
              </div>
            </div>

            <!-- Inquiry Category -->
            <div class="col-12">
              <label for="inquiry-category" class="form-label-custom mb-1.5"
                >Inquiry Type</label
              >
              <div class="input-icon-group">
                <i class="fa-solid fa-list-check"></i>
                <select
                  name="category"
                  id="inquiry-category"
                  class="form-select form-select-custom"
                >
                  <option value="general" selected>General Inquiry</option>
                  <option value="buy">Buying Land / Plot Assistance</option>
                  <option value="sell">Selling Property Support</option>
                  <option value="verification">
                    Legal & Registry Document Check
                  </option>
                  <option value="partnership">
                    Business & Agent Partnership
                  </option>
                </select>
              </div>
            </div>

            <!-- Message -->
            <div class="col-12">
              <label for="your-message" class="form-label-custom mb-1.5"
                >Your Message *</label
              >
              <div class="input-icon-group textarea-icon">
                <i class="fa-solid fa-comment-dots"></i>
                <textarea
                  name="message"
                  id="your-message"
                  class="form-control form-control-custom"
                  rows="4"
                  placeholder="Write your message here..."
                  required
                ></textarea>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="col-12 pt-2">
              <button
                type="submit"
                class="btn send-message-btn w-100 d-flex align-items-center justify-content-center gap-2"
              >
                <i class="fa-solid fa-paper-plane"></i>
                <span>Send Message</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Interactive Office Location Map Section -->
<div class="container my-4" style="max-width: 1080px">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="glass-card p-3 p-sm-4 p-md-5">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <div>
            <h2 class="card-heading mb-1">Our Head Office Location</h2>
            <p class="text-slate-400 small mb-0" style="color: #94a3b8">
              Visit our Danapur, Patna office for in-person property consultations and legal verification.
            </p>
          </div>
          <a
            href="https://www.google.com/maps/place/1,+Dwarikapuri+Main+Rd/@25.5870813,85.0318221,18z"
            target="_blank"
            class="btn btn-outline-light btn-sm rounded-pill fw-bold"
          >
            Get Directions <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
          </a>
        </div>
        
        <!-- Map Canvas -->
        <div id="map"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // 1. Inject Mapbox Token from Server environment
  mapboxgl.accessToken = "<%- process.env.MAP_TOKEN %>";

  const officeCoordinates = [85.0312629, 25.5873498]; // Coordinates for Dwarikapuri Rd No.1, Danapur Patna

  // 2. Initialize Map with Dark Style to match glassmorphism theme
  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/mapbox/streets-v12",
    center: officeCoordinates,
    zoom: 10,
  });

  // 3. Add Navigation Zoom & Rotation Controls
  map.addControl(new mapboxgl.NavigationControl(), "top-right");

  // 4. Create Informative Popup
  const popup = new mapboxgl.Popup({ offset: 25, closeButton: false })
    .setHTML(`
      <div style="color: #0f172a; padding: 4px;">
        <h6 style="font-weight: 800; margin-bottom: 4px; color: #f17649;">Quickplot Head Office</h6>
        <p style="font-size: 0.8rem; margin-bottom: 6px; line-height: 1.3;">
          Dwarikapuri Road No.1, Danapur Patna, Bihar
        </p>
        <span style="font-size: 0.7rem; font-weight: 700; color: #1e293b; background: #e2e8f0; padding: 2px 6px; border-radius: 4px;">
          Mon - Sat: 9 AM - 6 PM
        </span>
      </div>
    `);

  // 5. Add Custom Pin Marker with Attached Popup
  const marker1 = new mapboxgl.Marker({ color: "#f17649" })
    .setLngLat(officeCoordinates)
    .setPopup(popup)
    .addTo(map);

  // Automatically open the popup on map load
  popup.addTo(map);
</script>