<% layout("/layouts/boilerPlate") %>
<script>
  let mapToken = "<%- process.env.MAP_TOKEN %>"
  let coordinates = <%- JSON.stringify(quickplot.geometry.coordinates) %>;
  let quickplot = <%- JSON.stringify(quickplot) %>;

</script>


<body>
  <div class="container my-4 my-md-5">
    <div class="row justify-content-center">
      <div class="col-12 col-xl-10 property-details-card p-3 p-sm-4 p-md-5">
        
        <!-- Header Title -->
        <div class="mb-4">
          <h1 class="property-hero-title mb-0"><%= quickplot.title %></h1>
        </div>
        
        <!-- Content Grid: Image + Owner Contact Card -->
        <div class="row g-4 align-items-stretch mb-4">
          
          <!-- Left Column: Image Area -->
          <div class="col-12 col-md-7 col-lg-8">
            <div class="img-showcase-container h-100 shadow-sm">
              <img src="<%= quickplot.image.url %>" alt="<%= quickplot.title %>" loading="lazy" />
            </div>
          </div>
          
          <!-- Right Column: Owner Card -->
          <div class="col-12 col-md-5 col-lg-4">
            <div class="contact-owner-card p-4 h-100 d-flex flex-column justify-content-between">
              <div class="contact-top-bar"></div>
              
              <div>
                <span class="badge bg-light text-muted border mb-2 px-2.5 py-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">
                  Direct Seller
                </span>
                <h5 class="fw-bold text-dark mb-3" style="font-size: 1.15rem;">
                  Contact Property Owner
                </h5>
                
                <!-- Owner Profile Detail Box -->
                <div class="d-flex align-items-center gap-3 owner-info-box mb-4">
                  <div class="owner-avatar">
                    <i class="fa-solid fa-user-tie"></i>
                  </div>
                  <div class="text-truncate">
                    <span class="metric-label-title d-block mb-0.5" style="font-size: 0.65rem;">POSTED BY</span>
                    <h6 class="fw-bold text-dark mb-0 text-truncate" style="font-size: 0.95rem;">
                      <%= quickplot.name.toUpperCase() %>
                    </h6>
                  </div>
                </div>
              </div>

              <!-- Action Links (WhatsApp & Call) -->
              <div class="d-grid gap-2.5">
                <a href="https://wa.me/<%= quickplot.contact %>?text=Hello!%20I'm%20interested%20in%20your%20property:%20<%= encodeURIComponent(quickplot.title) %>" 
                   target="_blank" 
                   class="btn btn-contact-action btn-whatsapp-style">
                  <i class="fa-brands fa-whatsapp fs-5"></i>
                  <span>Chat on WhatsApp</span>
                </a>

                <a href="tel:<%= quickplot.contact %>" 
                   class="btn btn-contact-action btn-call-style">
                  <i class="fa-solid fa-phone fs-6"></i>
                  <span>Call Owner</span>
                </a>
              </div>

            </div>
          </div>

        </div>

        <!-- Metric Details Strip -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-sm-6">
            <div class="metric-card h-100 d-flex flex-column justify-content-center">
              <p class="metric-label-title mb-1">Asking Price</p>
              <div class="price-value-highlight mb-0">
                &#8377; <%= quickplot.price ? quickplot.price.toLocaleString("en-IN") : "N/A" %>
              </div>
            </div>
          </div>

          <div class="col-12 col-sm-6">
            <div class="metric-card h-100 d-flex flex-column justify-content-center">
              <p class="metric-label-title mb-1">Property Location</p>
              <div class="location-value-highlight d-flex align-items-center gap-2.5">
                <div class="location-badge-icon">
                  <i class="fa-solid fa-location-dot"></i>
                </div>
                <span><%= quickplot.location %></span>
              </div>
            </div>
          </div>
        </div>
      
        <!-- Owner Action Controls -->
        <% if(currUser && quickplot.owner && currUser.equals(quickplot.owner._id)) { %>
        <div class="d-flex flex-wrap gap-2.5 border-top pt-4 mt-2">
          <a href="/quickplots/<%= quickplot._id %>/edit" class="btn btn-outline-success btn-pill-manage d-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>Edit Post</span>
          </a>

          <form
            method="post"
            action="/quickplots/<%= quickplot._id %>?_method=DELETE"
            class="d-inline"
          >
            <button class="btn btn-outline-danger btn-pill-manage d-flex align-items-center gap-2">
              <i class="fa-solid fa-trash-can"></i>
              <span>Delete Post</span>
            </button>
          </form>
        </div>
        <% } %>
        
      </div>
    </div>
  </div>

  <div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      <div class="map-section p-3 p-sm-4 p-md-5">
        <h2 class="map-title mb-3">Property Location</h2>
        <div id="map"></div>
      </div>
    </div>
  </div>
</div>
  <script src="/js/map.js"></script>
</body>