<% layout("./layouts/boilerplate") %>

<div class="container my-3 my-md-5 about-hero-wrapper animate-fade-in" style="max-width: 960px;">
  
  <!-- Hero Banner Header -->
  <div class="text-center mb-4 mb-md-5 pb-2">
    <div class="hero-pill mb-3">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>Digital Land Platform</span>
    </div>
    <h1 class="hero-title mb-3">About Quickplot</h1>
    <p class="hero-subtitle mx-auto mb-0" style="max-width: 600px;">
      Connecting families with transparent, secure, and amazing digital land dealing experiences.
    </p>
  </div>

  <!-- Quick Platform Metrics -->
  <div class="row g-2.5 g-md-3 mb-4 mb-md-5">
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-number">100%</div>
        <div class="stat-label">Verified Properties</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-number">5,000+</div>
        <div class="stat-label">Happy Buyers</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-number">0%</div>
        <div class="stat-label">Hidden Brokerage</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-number">24/7</div>
        <div class="stat-label">Direct Connect</div>
      </div>
    </div>
  </div>

  <!-- Story Section Card -->
  <div class="about-card p-3.5 p-sm-4 p-md-5 mb-4 mb-md-5">
    <h2 class="section-title mb-4">Our Story</h2>
    <div class="story-text">
      <p class="mb-3">
        Quickplot was born out of a simple realization: while finding apartments or houses online had become straightforward, buying, selling, and evaluating raw land or plots remained fragmented, slow, and prone to legal opacity.
      </p>
      <p class="mb-3">
        Traditional property portals were tailored heavily toward constructed residential homes, leaving land buyers struggling with missing plot boundaries, non-transparent pricing per unit (like Katha, Gaj, or Sq. Ft.), and unverified land titles.
      </p>
      <p class="mb-0">
        Quickplot was created to eliminate the friction in land discovery and transactions. Built around clarity and efficiency, the platform bridges the gap between landowners, agents, and buyers.
      </p>
    </div>
  </div>

  <!-- Value Feature Grid -->
  <div class="mb-4 mb-md-5">
    <div class="text-center mb-4">
      <h2 class="section-title">Why Choose Quickplot</h2>
    </div>

    <div class="row g-3 g-md-4">
      <!-- Feature 1 -->
      <div class="col-12 col-sm-6 col-md-4">
        <div class="feature-badge d-flex flex-column justify-content-start">
          <div class="feature-icon-box">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h5 class="feature-title">Verified Land Titles</h5>
          <p class="feature-desc">Ensuring legal clarity and boundary verification for every plot listed on our platform.</p>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="col-12 col-sm-6 col-md-4">
        <div class="feature-badge d-flex flex-column justify-content-start">
          <div class="feature-icon-box">
            <i class="fa-solid fa-hand-holding-dollar"></i>
          </div>
          <h5 class="feature-title">Transparent Pricing</h5>
          <p class="feature-desc">Clear breakdown per unit area (Sq. Ft., Katha, or Gaj) with zero hidden fees or surprises.</p>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="col-12 col-sm-6 col-md-4">
        <div class="feature-badge d-flex flex-column justify-content-start">
          <div class="feature-icon-box">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h5 class="feature-title">Seamless Connect</h5>
          <p class="feature-desc">Direct WhatsApp and call links to connect buyers instantly with verified owners.</p>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="col-12 col-sm-6 col-md-4">
        <div class="feature-badge d-flex flex-column justify-content-start">
          <div class="feature-icon-box">
            <i class="fa-solid fa-map-location-dot"></i>
          </div>
          <h5 class="feature-title">Geo-Mapped Plots</h5>
          <p class="feature-desc">Interactive satellite map mapping for accurate plot boundaries and surrounding landmarks.</p>
        </div>
      </div>

      <!-- Feature 5 -->
      <div class="col-12 col-sm-6 col-md-4">
        <div class="feature-badge d-flex flex-column justify-content-start">
          <div class="feature-icon-box">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <h5 class="feature-title">Legal Due Diligence</h5>
          <p class="feature-desc">Assistance with registry checks, mutation status, and encumbrance certificates.</p>
        </div>
      </div>

      <!-- Feature 6 -->
      <div class="col-12 col-sm-6 col-md-4">
        <div class="feature-badge d-flex flex-column justify-content-start">
          <div class="feature-icon-box">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <h5 class="feature-title">Smart Land Analytics</h5>
          <p class="feature-desc">Access historical price growth trends and upcoming local development infrastructure insight.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Mission Section Card -->
  <div class="about-card p-3.5 p-sm-4 p-md-5 mb-4 mb-md-5">
    <h2 class="section-title mb-4">Our Mission</h2>
    <div class="mission-box p-3.5 p-md-4.5">
      <p class="mission-quote mb-0">
        "To transform complex land deals into a transparent, seamless, and one-click digital experience—where anyone can search, verify, and lock in land with complete confidence."
      </p>
    </div>
  </div>

  <!-- frequently asked Questions -->

  <section class="wrapper">
    <div class="faq" style="width: 130%;">
      <div class="faq-head">
        <div class="faq-head-icon"><i class="fa-regular fa-circle-question text-center"></i></div>
        <div class="faq-head-h1 text-center"><h1>Frequently Asked Questions</h1></div>
        <div class="faq-head-p text-center"><p>Everything you need to know about finding and booking kids activities on our platform</p></div>
      </div>
      
      <div class="faq-question-section">
        <button class="accordion-btn text-center">
          <p>What is Quickplot?</p>
          <i class="fa-solid fa-angle-down"></i>
        </button>
        <div class="answer">
          <p>Quickplo is a online land dealing platform, where you can buy and sell your lands without any intrruption and market price. </p>
        </div>
        <button class="accordion-btn text-center">
          <p>QuickPlot is a government platform!</p>
          <i class="fa-solid fa-angle-down"></i>
        </button>
        <div class="answer">
          <p>No Quickplot is a private owned platform circulate by the individual group of teams.</p>
        </div>
        <button class="accordion-btn text-center">
          <p>Does this platform provide compatitable price?</p>
          <i class="fa-solid fa-angle-down"></i>
        </button>
        <div class="answer">
          <p>Yes, QuickPlot is designed to give you competitive, direct market prices or even slightly less price according to market price..</p>
        </div>
      </div>
    </div>

    <div class="contact-section" style="margin-top: 5rem;">
      <div class="still-question"><p>Still have questions?</p></div>
      <a class="contact-support" href="/quickplots/contact" style="text-decoration: none; display: flex;justify-content: center; align-items: center; padding: 10px; border-radius: 10px; background-color: orangered; color: white; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;">
         <button  style="font-weight: 600;">Contact suport</button>
        
      </a>
    </div>
</section>


  <!-- CTA Banner -->
  <div class="cta-banner text-center p-3.5 p-md-5">
    <h3 class="fw-bold mb-2">Ready to find your dream plot?</h3>
    <p class="text-white-50 mb-4 mx-auto" style="max-width: 500px;">
      Explore hundreds of verified land listings or post your property in just a few clicks.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="/quickplots/post" class="btn cta-btn">Browse Properties</a>
      <a href="/quickplots/new" class="btn cta-btn-secondary">Post Free Land Ad</a>
    </div>
  </div>

</div>
</body>