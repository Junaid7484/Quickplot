<style>
.custom-flash-container {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 100099;
  display: flex;
  flex-direction: column;
  gap: 12px;
}


.flash-toast {
  min-width: 320px;
  max-width: 400px;
  display: flex;
  align-items: center;
  padding: 16px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  background: #ffffff;
  border-left: 5px solid transparent;
  animation: slideIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}


.flash-success { 
  border-left-color: #2ec4b6; 
}
.flash-success .flash-icon i { 
  color: #2ec4b6; 
}


.flash-error { 
  border-left-color: #e71d36; 
}
.flash-error .flash-icon i { 
  color: #e71d36; 
}


.flash-icon {
  font-size: 1.5rem;
  margin-right: 14px;
  display: flex;
  align-items: center;
}

.flash-content h5 {
  margin: 0 0 2px 0;
  font-size: 1.2rem;
  font-weight: 600;
  color: #2d3748;
}

.flash-content p {
  margin: 0;
  font-size: 1rem;
  color: #718096;
  line-height: 1.4;
}

.flash-close {
  margin-left: auto;
  background: none;
  border: none;
  font-size: 1.5rem;
  color: #a0aec0;
  cursor: pointer;
  padding: 0 0 0 12px;
  line-height: 1;
  transition: color 0.2s ease;
}
.flash-close:hover { 
  color: #4a5568; 
}

@keyframes slideIn {
  from { 
    transform: translateX(120%); 
    opacity: 0; 
  }
  to { 
    transform: translateX(0); 
    opacity: 1; 
  }
  
}
</style>


<div class="custom-flash-container">
  
  <% if (success && success.length > 0) { %>
    <div class="flash-toast flash-success">
      <div class="flash-icon">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div class="flash-content">
        <h5>Success</h5>
        <p><%= success %></p>
      </div>
      <button type="button" class="flash-close" onclick="this.parentElement.style.display='none'">&times;</button>
    </div>
  <% } %>

  <% if (error && error.length > 0) { %>
    <div class="flash-toast flash-error">
      <div class="flash-icon">
        <i class="fa-solid fa-circle-xmark"></i>
      </div>
      <div class="flash-content">
        <h5>Error</h5>
        <p><%= error %></p>
      </div>
      <button type="button" class="flash-close" onclick="this.parentElement.style.display='none'">&times;</button>
    </div>
  <% } %>

</div>

<script>
  document.addEventListener("DOMContentLoaded", ()=> {
    const flashContainer = document.querySelector(".custom-flash-container")
    setTimeout(()=> {
      flashContainer.remove();
    },5000)
  })
</script>